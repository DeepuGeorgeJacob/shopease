#!/usr/bin/env bash
# Block pushes that update a protected branch (main/master) or publish tags.
set -euo pipefail

protected="${GIT_PROTECTED_BRANCHES:-main master}"

is_protected() {
  local branch="${1#refs/heads/}"
  local b
  for b in $protected; do
    if [ "$branch" = "$b" ]; then
      return 0
    fi
  done
  return 1
}

blocked_branch=""
blocked_tag=""
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/tags/*)
      blocked_tag="$remote_ref"
      ;;
    *)
      if is_protected "$remote_ref"; then
        blocked_branch="$remote_ref"
      fi
      ;;
  esac
done

if [ -n "$blocked_branch" ]; then
  b="${blocked_branch#refs/heads/}"
  echo "ERROR: pushing to protected branch '$b' is blocked." >&2
  echo "Push a feature branch instead, then open a pull request." >&2
  exit 1
fi

if [ -n "$blocked_tag" ]; then
  echo "ERROR: pushing tags is blocked ('${blocked_tag#refs/tags/}')." >&2
  echo "Remove tag refs from the push (no --tags or refs/tags/... refspec). Push only branches." >&2
  exit 1
fi

current="$(git symbolic-ref --quiet --short HEAD || true)"
if [ -n "$current" ] && is_protected "$current"; then
  echo "ERROR: '$current' is a protected branch; pushing it is blocked." >&2
  echo "Create a feature branch first:" >&2
  echo "  git switch -c <type>/<slug> origin/$current" >&2
  exit 1
fi

exit 0
